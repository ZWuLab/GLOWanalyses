# cloud/docker/versions.env - the one place that names the versions inside the GLOW image.
# The build recipe (.github/workflows/docker-image.yaml) reads it and passes every value as a
# build argument; the NEWS.md "Requires GLOWr x and GLOWpipeline y" line must agree with it.
# File Log: 2026-10-29 GLOWr 0.3.4 and GLOWpipeline 0.2.2 (the optimal-weight quadrature and
#           debug_errors), by Claude Code (Fable 5.1);
#           2026-10-23 GLOWr 0.3.3 (the standardized normal approximation; GFisher v0.3.2 also
#           carries the HYB fixes), by Claude Code (Fable 5.1);
#           2026-10-22 (night) GFisher v0.3.2 and base 2026-10-22.4 (the Armadillo pin dropped);
#           2026-10-22 created by Claude Code (Fable 5.1), prompted by ZWu (plan 12).
GLOW_BASE_TAG=2026-10-22.4
GFISHER_TAG=v0.3.2
GLOWR_VERSION=0.3.4
GLOWPIPELINE_VERSION=0.2.2
